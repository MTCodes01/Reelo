# Environment Configuration
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost:3294,https://reelo.domain.com,http://reelo.domain.com

# Rate Limiting
RATE_LIMIT=10/minute

# File Management
DOWNLOAD_DIR=./downloads
FILE_RETENTION_HOURS=1
CLEANUP_INTERVAL_MINUTES=30

# Server Settings
HOST=0.0.0.0
PORT=7654

# Logging
LOG_LEVEL=INFO

# ── Concurrency / resource limits (shared-server safe defaults) ────────────────
# MAX_WORKERS: concurrent yt-dlp/ffmpeg jobs.
#   2 = safe for a 16 GB server running other containers.
#   Raise to 3-4 only if the host has spare CPU and at least 4 GB free RAM.
MAX_WORKERS=2

# FFMPEG_THREADS: CPU threads ffmpeg uses per conversion.
#   2 = polite on a shared host (leaves headroom for other containers).
#   0 = let ffmpeg decide (may use ALL cores -- avoid on shared hosts).
FFMPEG_THREADS=2
